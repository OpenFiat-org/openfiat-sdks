{
  "name": "@openfiat/sdk",
  "version": "0.1.0",
  "description": "Official TypeScript/JavaScript SDK for the OpenFiat protocol.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/OpenFiat-org/openfiat-sdks",
    "directory": "typescript"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./node": {
      "types": "./src/node.ts",
      "import": "./dist/node.js",
      "require": "./dist/node.cjs"
    }
  },
  "files": [
    "dist",
    "src",
    "tsconfig.json"
  ],
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup src/index.ts src/node.ts --format esm,cjs --clean",
    "dev": "tsup src/index.ts src/node.ts --format esm,cjs --watch",
    "prepare": "npm run build",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "build:types": "tsup src/index.ts src/node.ts --format esm,cjs --dts-only --tsconfig tsconfig.dts.json && node scripts/assert-dts.mjs"
  },
  "dependencies": {
    "@noble/ciphers": "^2.2.0",
    "@noble/curves": "^2.2.0",
    "@noble/ed25519": "^2.1.0",
    "@noble/hashes": "^2.2.0",
    "@solana/web3.js": "^1.98.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.13.0",
    "@types/node": "^26.1.2",
    "eslint": "^10.8.0",
    "tsup": "^8.3.0",
    "tsx": "^4.19.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.12.0",
    "vitest": "^2.1.0"
  }
}
